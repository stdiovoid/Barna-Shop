async function renderProducts() {
    const container = document.getElementById("products");
    if (!container) return;

    try {
        const response = await fetch("products.json");
        const products = await response.json();

        if (products.length === 0) {
            container.innerHTML = `
                <div class="empty-products">
                    <h3>🎮 هنوز اکانتی موجود نیست</h3>
                    <p>به‌زودی اکانت‌های جدید اضافه می‌شوند.</p>
                </div>
            `;
            return;
        }

        container.innerHTML = products.map(product => `
            <article class="product-card">
                <img src="${product.images?.[0] || product.image || ''}" alt="${product.title}">
                <h3>${product.title}</h3>
                <p>${product.description}</p>
                <div class="price">${Number(product.price).toLocaleString('fa-IR')} تومان</div>
                <p>${product.status === "sold" ? "فروخته شده" : "موجود"}</p>
            </article>
        `).join("");

    } catch (error) {
        container.textContent = "خطا در بارگذاری محصولات.";
    }
}

renderProducts();;
