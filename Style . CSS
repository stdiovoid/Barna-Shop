
@import url('https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800&display=swap');

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Vazirmatn', sans-serif;
    background: #090b12;
    color: #fff;
}

header {
    background: #111522;
    padding: 22px 7%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #252b3b;
}

.logo {
    color: #f5b942;
    font-size: 25px;
    font-weight: 800;
}

.hero {
    padding: 85px 20px;
    text-align: center;
    background: linear-gradient(135deg, #171d30, #090b12);
}

.hero h1 {
    font-size: 38px;
    color: #f5b942;
    margin-bottom: 15px;
}

.hero p {
    color: #b8bdca;
    font-size: 16px;
}

.products {
    padding: 45px 7%;
}

.products h2 {
    margin-bottom: 30px;
    color: #f5b942;
}

.product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 22px;
}

.product-card {
    background: #151a28;
    border: 1px solid #292f40;
    border-radius: 15px;
    padding: 18px;
    transition: 0.3s;
}

.product-card:hover {
    transform: translateY(-5px);
    border-color: #f5b942;
}

.product-card img {
    width: 100%;
    height: 170px;
    object-fit: cover;
    border-radius: 10px;
}

.product-card h3 {
    margin: 15px 0;
}

.price {
    color: #f5b942;
    font-weight: 800;
    margin-bottom: 15px;
}

.buy-button {
    display: block;
    text-align: center;
    padding: 12px;
    border-radius: 9px;
    background: #f5b942;
    color: #111;
    text-decoration: none;
    font-weight: 800;
}

footer {
    text-align: center;
    padding: 25px;
    color: #858b9b;
    border-top: 1px solid #252b3b;
}

footer a {
    color: #f5b942;
    text-decoration: none;
}

@media (max-width: 600px) {
    .hero h1 {
        font-size: 27px;
    }
}
.admin-link {
    display: inline-block;
    margin-top: 12px;
    font-size: 10px;
    color: #555b68;
    text-decoration: none;
    opacity: 0.35;
    transition: 0.3s;
}

.admin-link:hover {
    opacity: 1;
    color: #f5b942;
}
